{
  "name": "personal-europe-travel-guide",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app/page.tsx app/layout.tsx components/travel-guide-v3.tsx components/mini-route.tsx components/shell components/mobile features hooks/use-local-storage.ts lib scripts views",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "audit": "node scripts/generate-media-metadata.mjs && node scripts/audit.mjs && node scripts/generate-unverified.mjs && node scripts/asset-coverage.mjs --write && node scripts/gallery-quality-audit.mjs --write && node scripts/generate-offline-core.mjs && node scripts/gallery-quality-audit.mjs --write && node scripts/privacy-audit.mjs",
    "test:linkage": "node --experimental-strip-types scripts/linkage-test.mjs",
    "linkage-test": "pnpm test:linkage",
    "test:gallery-offline": "node scripts/gallery-offline-test.mjs",
    "test:architecture": "node scripts/architecture-audit.mjs",
    "test:mobile": "node --experimental-strip-types scripts/mobile-shell-test.mjs",
    "test:desktop-workspace": "node --experimental-strip-types scripts/desktop-workspace-test.mjs",
    "test:travel-intelligence": "node --experimental-strip-types scripts/travel-intelligence-test.mjs",
    "test:readiness": "node --experimental-strip-types scripts/readiness-test.mjs",
    "test:presentation": "node scripts/presentation-test.mjs",
    "audit:privacy": "node scripts/privacy-audit.mjs",
    "unverified": "node scripts/generate-unverified.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test:linkage && pnpm build && pnpm run audit"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "fake-indexeddb": "6.2.4",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "^0.35.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

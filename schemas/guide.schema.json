{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.travel/europe-guide.schema.json",
  "title": "Personal Europe Travel Guide",
  "type": "object",
  "required": ["trip", "days", "places", "options", "images", "gyms", "hotels", "bookings", "tasks", "restaurants", "xhs", "budget", "checklist", "essentials", "conflicts"],
  "properties": {
    "trip": {
      "type": "object",
      "required": ["id", "title", "startDate", "endDate", "europeNights", "hotelChanges", "cities", "coverImage", "sourcePriority"],
      "properties": { "cities": { "type": "array", "minItems": 6, "maxItems": 6 } }
    },
    "days": {
      "type": "array", "minItems": 18, "maxItems": 18,
      "items": { "type": "object", "required": ["day", "date", "city", "theme", "summary", "walking", "fatigue", "goldenHour", "blueHour", "dayBudget", "gymIds", "lossCut", "timeline", "shooting"] }
    },
    "places": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["id", "name", "city", "type", "mapQuery", "coordinateStatus"] }
    },
    "options": {
      "type": "array", "minItems": 24, "maxItems": 24,
      "items": { "type": "object", "required": ["id", "city", "name", "kind", "recommendedDays", "duration", "bestFor", "swapRule", "booking", "mapQuery", "source", "status"] }
    },
    "images": {
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["id", "day", "dayId", "placeId", "file", "key", "caption", "use", "role", "type", "timeOfDay", "bestTime", "focalLength", "composition", "credit", "sourcePage", "sourceType", "visuallyReviewed", "lastVerified"] }
    },
    "gyms": {
      "type": "array", "minItems": 8, "maxItems": 10,
      "items": { "type": "object", "required": ["id", "name", "city", "dayPass", "passMethod", "hours", "distance", "equipment", "crowd", "lighting", "style", "photo", "time", "recommendedDays", "image", "source"] }
    },
    "hotels": {
      "type": "object", "required": ["goalRange", "hardMax", "selectedTotal", "quietRequest", "veniceComparison", "hotels"],
      "properties": { "hotels": { "type": "array", "minItems": 24, "maxItems": 24, "items": { "type": "object", "required": ["id", "city", "role", "name", "rating", "openingRenovation", "roomCondition", "noise", "bed", "heating", "privateBathroom", "frontDeskStorage", "transport", "pros", "cons", "risk", "selected", "roomName", "roomArea", "bedType", "ratingCount", "refundableRoomMatch", "airConditioning", "lateArrival", "luggageStorage", "roomImages", "priceSource", "lastVerified"] } } }
    },
    "bookings": { "type": "object", "required": ["statuses", "items"] },
    "tasks": { "type": "object", "required": ["statuses", "items"], "properties": { "items": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "title", "note", "due", "group", "status", "linkedBookingId", "lastVerified"] } } } },
    "restaurants": { "type": "array", "minItems": 24, "items": { "type": "object", "required": ["id", "city", "name", "meal", "dishes", "price", "hours", "reservation", "distance", "source", "recommendedDays", "mustEat", "mapQuery", "xhsKeyword", "photoStatus", "lastVerified"] } },
    "xhs": { "type": "array", "minItems": 20, "items": { "type": "object", "required": ["id", "city", "category", "keyword", "url", "linkType", "lastVerified"] } },
    "budget": { "type": "object", "required": ["hardCap", "targetMin", "targetMax", "shoppingFloor", "planTotal", "categories", "adjustOrder", "neverCut"] },
    "checklist": { "type": "object", "required": ["groups", "visaReality"] },
    "essentials": { "type": "object", "required": ["groups", "quietMessage"] },
    "conflicts": { "type": "object", "required": ["items"] }
  }
}
